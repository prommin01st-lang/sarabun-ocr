# ── Telegram ────────────────────────────────────────────────
# สร้าง token จาก @BotFather แล้ววางที่นี่
TELEGRAM_BOT_TOKEN=
# จำกัดผู้ใช้บอท (เว้นว่าง = ทุกคน) — คั่นด้วย comma/space
ALLOWED_USER_IDS=
# admin: แก้/ลบเอกสารของใครก็ได้ (เจ้าของแก้ของตัวเองได้เสมอ)
ADMIN_USER_IDS=

# ── Database (metadata store) ───────────────────────────────
# เว้นว่าง = ใช้ SQLite (data/metadata.db)
# ใช้ Postgres local: postgresql+psycopg://<user>:<pass>@localhost:5432/ocr_file_chat
# DATABASE_URL=

# ── Ollama / LLM ────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b          # default ทุก task
# override ราย task (เว้นว่าง = ใช้ OLLAMA_MODEL) เช่นใช้ตัวใหญ่กว่าเฉพาะตอนสรุป
# ANSWER_MODEL=qwen2.5:3b
# SUMMARY_MODEL=qwen2.5:7b
# generation options
LLM_TEMPERATURE=0.2             # ต่ำ = ตรงข้อเท็จจริง (เหมาะ RAG)
LLM_NUM_CTX=8192               # context window — กัน prompt ยาวโดนตัด
LLM_NUM_PREDICT=1024           # max output tokens (-1 = ไม่จำกัด)
LLM_TIMEOUT=300

# ── Embedding ───────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── OCR (PaddleOCR ภาษาหลักสำหรับรูปเดี่ยว) ─────────────────
OCR_LANG=th

# ── Chunking / Retrieval ────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K=5

# ── Safety / limits ─────────────────────────────────────────
MAX_FILE_MB=25          # R1: ปฏิเสธไฟล์ใหญ่กว่านี้
SANITIZE=false          # R2: true = ปกปิด email/เบอร์/เลขบัตร ในเนื้อหา

# ── Paths (ปล่อยว่างเพื่อใช้ ./data) ────────────────────────
# DATA_DIR=
COLLECTION_NAME=documents
